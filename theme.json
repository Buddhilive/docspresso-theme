{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "48rem",
      "wideSize": "75rem"
    },
    "color": {
      "custom": false,
      "customGradient": false,
      "customDuotone": false,
      "palette": [
        { "slug": "white", "name": "White", "color": "#ffffff" },
        { "slug": "neutral-50", "name": "Neutral 50", "color": "#fbfaf9" },
        { "slug": "neutral-100", "name": "Neutral 100", "color": "#f6f4f4" },
        { "slug": "neutral-200", "name": "Neutral 200", "color": "#ebe7e5" },
        { "slug": "neutral-300", "name": "Neutral 300", "color": "#d9d2ce" },
        { "slug": "neutral-400", "name": "Neutral 400", "color": "#b3a59e" },
        { "slug": "neutral-500", "name": "Neutral 500", "color": "#8f7a70" },
        { "slug": "neutral-600", "name": "Neutral 600", "color": "#6f5f58" },
        { "slug": "neutral-700", "name": "Neutral 700", "color": "#564943" },
        { "slug": "neutral-800", "name": "Neutral 800", "color": "#3c332f" },
        { "slug": "neutral-900", "name": "Neutral 900", "color": "#28221f" },
        { "slug": "neutral-950", "name": "Neutral 950", "color": "#171412" },
        { "slug": "primary-50", "name": "Primary 50", "color": "#fef3f0" },
        { "slug": "primary-100", "name": "Primary 100", "color": "#fde8e3" },
        { "slug": "primary-200", "name": "Primary 200", "color": "#f8cfc3" },
        { "slug": "primary-300", "name": "Primary 300", "color": "#f0af9d" },
        { "slug": "primary-400", "name": "Primary 400", "color": "#e28369" },
        { "slug": "primary-500", "name": "Primary 500", "color": "#c65737" },
        { "slug": "primary-600", "name": "Primary 600", "color": "#a7452a" },
        { "slug": "primary-700", "name": "Primary 700", "color": "#8c3821" },
        { "slug": "primary-800", "name": "Primary 800", "color": "#6e2d1c" },
        { "slug": "primary-900", "name": "Primary 900", "color": "#4f2317" },
        { "slug": "primary-950", "name": "Primary 950", "color": "#2d1610" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "\"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace",
          "slug": "geist-mono",
          "name": "Geist Mono",
          "fontFace": [
            {
              "fontFamily": "Geist Mono",
              "fontWeight": "400 700",
              "fontStyle": "normal",
              "fontStretch": "normal",
              "src": [ "file:./assets/fonts/GeistMono-Variable.woff2" ]
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "medium", "name": "Medium", "size": "1rem" },
        { "slug": "large", "name": "Large", "size": "1.25rem" },
        { "slug": "x-large", "name": "Extra Large", "size": "1.75rem" },
        { "slug": "xx-large", "name": "XX Large", "size": "2.75rem" }
      ],
      "lineHeight": true
    },
    "spacing": {
      "units": ["px", "%", "em", "rem", "vh", "vw"],
      "padding": true,
      "margin": true,
      "blockGap": true
    },
    "border": {
      "radius": true,
      "color": true,
      "width": true,
      "style": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--neutral-900)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--geist-mono)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": { "text": "var(--wp--preset--color--primary-700)" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--primary-800)" }
        }
      },
      "heading": {
        "typography": { "fontWeight": "600", "lineHeight": "1.2" },
        "color": { "text": "var(--wp--preset--color--neutral-950)" }
      },
      "button": {
        "color": {
          "text": "var(--wp--preset--color--white)",
          "background": "var(--wp--preset--color--primary-600)"
        },
        "border": { "radius": "0.5rem" },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--white)",
            "background": "var(--wp--preset--color--primary-700)"
          }
        }
      }
    },
    "blocks": {
      "core/post-title": {
        "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" }
      },
      "core/quote": {
        "border": {
          "left": {
            "color": "var(--wp--preset--color--primary-300)",
            "width": "3px",
            "style": "solid"
          }
        },
        "spacing": {
          "padding": { "left": "1.25rem" },
          "margin": { "top": "1.5rem", "bottom": "1.5rem" }
        },
        "color": {
          "text": "var(--wp--preset--color--neutral-700)"
        }
      },
      "core/pullquote": {
        "border": {
          "top": { "color": "var(--wp--preset--color--primary-300)", "width": "2px", "style": "solid" },
          "bottom": { "color": "var(--wp--preset--color--primary-300)", "width": "2px", "style": "solid" }
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)",
          "fontWeight": "600"
        },
        "color": {
          "text": "var(--wp--preset--color--neutral-950)"
        },
        "spacing": {
          "padding": { "top": "1.5rem", "bottom": "1.5rem" }
        }
      },
      "core/table": {
        "border": {
          "color": "var(--wp--preset--color--neutral-200)",
          "width": "1px",
          "style": "solid"
        },
        "color": {
          "text": "var(--wp--preset--color--neutral-800)"
        }
      },
      "core/separator": {
        "color": {
          "text": "var(--wp--preset--color--neutral-300)",
          "background": "var(--wp--preset--color--neutral-300)"
        }
      },
      "core/code": {
        "color": {
          "text": "var(--wp--preset--color--primary-800)",
          "background": "var(--wp--preset--color--neutral-100)"
        },
        "border": {
          "radius": "0.375rem",
          "color": "var(--wp--preset--color--neutral-200)",
          "width": "1px",
          "style": "solid"
        },
        "spacing": {
          "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1rem", "right": "1rem" }
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      },
      "core/preformatted": {
        "color": {
          "text": "var(--wp--preset--color--neutral-800)",
          "background": "var(--wp--preset--color--neutral-100)"
        },
        "border": {
          "radius": "0.5rem",
          "color": "var(--wp--preset--color--neutral-200)",
          "width": "1px",
          "style": "solid"
        },
        "spacing": {
          "padding": { "top": "1rem", "bottom": "1rem", "left": "1.25rem", "right": "1.25rem" }
        }
      },
      "core/list": {
        "spacing": {
          "margin": { "bottom": "1rem" }
        }
      },
      "core/image": {
        "border": {
          "radius": "0.75rem"
        }
      },
      "core/button": {
        "variations": {
          "outline": {
            "color": {
              "text": "var(--wp--preset--color--neutral-900)",
              "background": "transparent"
            },
            "border": {
              "color": "var(--wp--preset--color--neutral-300)",
              "width": "1px",
              "style": "solid",
              "radius": "0.5rem"
            },
            ":hover": {
              "color": {
                "background": "var(--wp--preset--color--neutral-100)"
              }
            }
          }
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    {
      "name": "template-front-hero",
      "title": "Front Page (Hero)",
      "postTypes": ["page"]
    },
    {
      "name": "template-blog-grid",
      "title": "Blog Listing",
      "postTypes": ["page"]
    }
  ]
}
