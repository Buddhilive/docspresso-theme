{
  "name": "docspresso-theme",
  "version": "1.0.0",
  "description": "A tech blog WordPress theme with Tailwind CSS",
  "main": "index.js",
  "scripts": {
    "build": "npx tailwindcss -i ./assets/css/tailwind.css -o ./assets/css/tailwind-output.css",
    "dev": "npx tailwindcss -i ./assets/css/tailwind.css -o ./assets/css/tailwind-output.css --watch",
    "tailwind:build": "npx tailwindcss -i ./assets/css/tailwind.css -o ./assets/css/tailwind-output.css",
    "tailwind:watch": "npx tailwindcss -i ./assets/css/tailwind.css -o ./assets/css/tailwind-output.css --watch"
  },
  "keywords": [
    "wordpress",
    "theme",
    "tailwind",
    "tech-blog"
  ],
  "author": "Your Name",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "tailwindcss": "^3.3.0"
  }
}